# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: SQLite database path for Prisma / SQLite engine.
DATABASE_URL="file:./sandhani.db"

# JWT_SECRET: Secret key used to sign HTTP-only JWT authentication cookies.
JWT_SECRET="sandhani-rmc-unit-room81-jwt-secret"
